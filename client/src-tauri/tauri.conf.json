{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScreenRaid Receiver",
  "version": "0.1.0",
  "identifier": "com.screenraid.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenRaid Receiver",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "overlay"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$APPCONFIG/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRDkzNzAxMTk2MUM1RkMKUldUOHhXRVpBVGZaSUhobk1qL2d1cUNxR2VMbGU3UmV3QmFMS2JEUEt0M25ScmFoSmRrM1BFL0QK",
      "endpoints": [
        "https://github.com/StriikzLeLama/LamaWorlds_ScreenRaid/releases/latest/download/latest.json"
      ]
    }
  }
}
