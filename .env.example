# Server
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite://./data/screenraid.db
JWT_SECRET=change-me-in-production-use-256-bit-secret
STORAGE_PATH=./data/media
CORS_ORIGINS=http://localhost:1420,tauri://localhost
RUST_LOG=screenraid_server=info,tower_http=info
ADMIN_USERNAMES=StriikzLeLama
# Solo overlay testing: allow pranking yourself (dev only)
ALLOW_SELF_PRANK=false
# Built web dashboard — Docker uses /app/web (do not override in CT .env)
# STATIC_PATH=./web

# KLIPY GIF search (https://partner.klipy.com/api-keys) — leave empty to hide search
KLIPY_API_KEY=

# Docker: bind port on a specific host IP (e.g. 192.168.1.109) or 0.0.0.0 for all interfaces
BIND_HOST=0.0.0.0

# Client — Tauri receiver (desktop overlay app)
VITE_SERVER_URL=http://localhost:8080
